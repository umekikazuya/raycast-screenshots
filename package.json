{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "screenshots",
  "title": "Screenshots",
  "description": "Screenshots tasks",
  "icon": "extension-icon.png",
  "author": "kazuyaumeki",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Media"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-screenshots",
      "title": "Search Screenshots",
      "description": "Browse and manage recent screenshots",
      "mode": "view"
    },
    {
      "name": "take-screenshots",
      "title": "Take Screenshots",
      "description": "Take Screenshots.",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "screenshotDirectory",
      "title": "Screenshot Directory",
      "description": "Folder to search for screenshots. Defaults to the Desktop.",
      "type": "directory",
      "required": false
    },
    {
      "name": "gridItemSize",
      "title": "Grid Item Size",
      "description": "Size of screenshot previews in the gallery.",
      "type": "dropdown",
      "required": false,
      "default": "medium",
      "data": [
        {
          "title": "Small",
          "value": "small"
        },
        {
          "title": "Medium",
          "value": "medium"
        },
        {
          "title": "Large",
          "value": "large"
        }
      ]
    }
  ],
  "tools": [],
  "dependencies": {
    "@raycast/api": "^2.10.1",
    "@raycast/utils": "^2.2.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
